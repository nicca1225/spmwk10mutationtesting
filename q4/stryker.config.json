{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "configFile": "q4/jest.config.js"
  },
  "coverageAnalysis": "perTest",
  "mutate": ["q4/src/**/*.ts"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/q4-mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/q4-mutation/mutation.json" }
}
